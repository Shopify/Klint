{
  "name": "@shopify/klint-mcp",
  "version": "1.0.0",
  "description": "MCP server for Klint creative coding framework",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "dashboard.js",
    "setup-cli.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node test-server.js",
    "dashboard": "node dashboard.js",
    "dev:dashboard": "nodemon dashboard.js",
    "setup": "node setup-cli.js",
    "prepublishOnly": "npm run build && npm run prepare-publish",
    "prepare-publish": "node scripts/prepare-publish.js",
    "publish:prepare": "npm run build && npm run test"
  },
  "keywords": [
    "mcp",
    "klint",
    "creative-coding",
    "canvas",
    "react"
  ],
  "author": "Klint Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "^3.23.8",
    "express": "^4.22.1",
    "socket.io": "^4.7.4",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
