{
  "name": "klint-monorepo",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Klint - Modern creative coding library",
  "author": "arthurcloche",
  "license": "MIT",
  "workspaces": [
    "packages/klint",
    "docusaurus"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/klint",
    "build:docs": "npm run build --workspace=docusaurus",
    "dev": "npm run dev --workspaces --if-present",
    "dev:klint": "npm run dev --workspace=packages/klint",
    "dev:docs": "npm run start --workspace=docusaurus",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspace=packages/klint",
    "typecheck": "npm run typecheck --workspace=packages/klint && npm run typecheck --workspace=docusaurus",
    "quality": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke --workspace=packages/klint && npm run build:docs",
    "clean": "npm run clean --workspaces --if-present",
    "release:check": "node scripts/release.mjs --check",
    "release": "node scripts/release.mjs",
    "sandbox": "npx @shopify/klint create-sandbox"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "webpack": "5.105.4"
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "webpack": "5.105.4"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shopify/Klint"
  },
  "bugs": {
    "url": "https://github.com/Shopify/Klint/issues"
  },
  "homepage": "https://github.com/Shopify/Klint"
}
