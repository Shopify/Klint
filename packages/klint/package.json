{
  "name": "@shopify/klint",
  "author": "arthurcloche",
  "license": "MIT",
  "version": "0.1.0",
  "description": "A modern creative coding library",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "klint-create-editor": "./bin/create-editor",
    "klint-create-sandbox": "./bin/create-sandbox"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./plugins": "@shopify/klint-plugins"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shopify/Klint"
  },
  "publishConfig": {
    "access": "public",
    "@shopify:registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "creative-coding",
    "klint",
    "javascript",
    "2d",
    "canvas",
    "generative-art",
    "processing",
    "html5"
  ],
  "homepage": "https://github.com/Shopify/Klint",
  "browserslist": [
    "> 1%, not dead, not ie 11, not op_mini all"
  ],
  "bugs": {
    "url": "https://github.com/Shopify/Klint/issues"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --external=react --external=react-dom",
    "build:minified": "tsup src/index.tsx --format esm,cjs --dts --minify --external=react --external=react-dom",
    "dev": "tsup src/index.tsx --format esm,cjs --dts --watch --external=react --external=react-dom",
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rimraf dist",
    "version": "yarn version"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "optionalDependencies": {
    "@shopify/klint-mcp": "^0.1.0",
    "@shopify/klint-plugins": "^0.1.0",
    "@shopify/klint-web-component": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "^16.0.0",
    "@types/react-dom": "^16.0.0",
    "concurrently": "^8.2.0",
    "jsdom": "^26.0.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.0.0",
    "vite": "^6.2.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.1",
    "vitest-canvas-mock": "^0.3.3"
  }
}
