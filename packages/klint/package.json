{
  "name": "@shopify/klint",
  "version": "0.5.0",
  "description": "A compact immediate-mode Canvas 2D toolkit for React and vanilla JavaScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shopify/klint.git",
    "directory": "packages/klint"
  },
  "homepage": "https://shopify.github.io/klint/",
  "bugs": "https://github.com/Shopify/klint/issues",
  "author": "Shopify",
  "keywords": [
    "react",
    "canvas",
    "creative-coding",
    "generative-art",
    "graphics",
    "animation",
    "2d"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "require": "./dist/native.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js",
      "require": "./dist/plugins/index.cjs"
    },
    "./plugins/Bezier": {
      "types": "./dist/plugins/Bezier.d.ts",
      "import": "./dist/plugins/Bezier.js",
      "require": "./dist/plugins/Bezier.cjs"
    },
    "./plugins/Polyline": {
      "types": "./dist/plugins/Polyline.d.ts",
      "import": "./dist/plugins/Polyline.js",
      "require": "./dist/plugins/Polyline.cjs"
    },
    "./plugins/FontParser": {
      "types": "./dist/plugins/FontParser.d.ts",
      "import": "./dist/plugins/FontParser.js",
      "require": "./dist/plugins/FontParser.cjs"
    },
    "./plugins/FontParser/ttf": {
      "types": "./dist/plugins/FontParserTTF.d.ts",
      "import": "./dist/plugins/FontParserTTF.js",
      "require": "./dist/plugins/FontParserTTF.cjs"
    },
    "./plugins/FontParser/otf": {
      "types": "./dist/plugins/FontParserOTF.d.ts",
      "import": "./dist/plugins/FontParserOTF.js",
      "require": "./dist/plugins/FontParserOTF.cjs"
    },
    "./plugins/FontParser/woff": {
      "types": "./dist/plugins/FontParserWOFF.d.ts",
      "import": "./dist/plugins/FontParserWOFF.js",
      "require": "./dist/plugins/FontParserWOFF.cjs"
    },
    "./plugins/FontParser/woff2": {
      "types": "./dist/plugins/FontParserWOFF2.d.ts",
      "import": "./dist/plugins/FontParserWOFF2.js",
      "require": "./dist/plugins/FontParserWOFF2.cjs"
    },
    "./plugins/Catmull": {
      "types": "./dist/plugins/Catmull.d.ts",
      "import": "./dist/plugins/Catmull.js",
      "require": "./dist/plugins/Catmull.cjs"
    },
    "./plugins/Delaunay": {
      "types": "./dist/plugins/Delaunay.d.ts",
      "import": "./dist/plugins/Delaunay.js",
      "require": "./dist/plugins/Delaunay.cjs"
    },
    "./plugins/Sprites": {
      "types": "./dist/plugins/Sprites.d.ts",
      "import": "./dist/plugins/Sprites.js",
      "require": "./dist/plugins/Sprites.cjs"
    },
    "./plugins/Projector": {
      "types": "./dist/plugins/Projector.d.ts",
      "import": "./dist/plugins/Projector.js",
      "require": "./dist/plugins/Projector.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "bin": {
    "klint": "./bin/klint",
    "create-sandbox": "./bin/create-sandbox",
    "create-editor": "./bin/create-editor"
  },
  "scripts": {
    "build": "tsup",
    "build:minify": "tsup --minify",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "smoke": "node scripts/smoke-dist.mjs",
    "quality": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.2.7",
    "vitest-canvas-mock": "^0.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
