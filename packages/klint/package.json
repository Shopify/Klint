{
  "name": "@shopify/klint",
  "author": "arthurcloche",
  "license": "MIT",
  "version": "0.4.0",
  "description": "A modern creative coding library",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "klint-create-editor": "bin/create-editor",
    "klint-create-sandbox": "bin/create-sandbox"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js",
      "require": "./dist/plugins/index.cjs"
    },
    "./plugins/Bezier": {
      "types": "./dist/plugins/Bezier.d.ts",
      "import": "./dist/plugins/Bezier.js",
      "require": "./dist/plugins/Bezier.cjs"
    },
    "./plugins/Polyline": {
      "types": "./dist/plugins/Polyline.d.ts",
      "import": "./dist/plugins/Polyline.js",
      "require": "./dist/plugins/Polyline.cjs"
    },
    "./plugins/FontParser": {
      "types": "./dist/plugins/FontParser.d.ts",
      "import": "./dist/plugins/FontParser.js",
      "require": "./dist/plugins/FontParser.cjs"
    },
    "./plugins/Catmull": {
      "types": "./dist/plugins/Catmull.d.ts",
      "import": "./dist/plugins/Catmull.js",
      "require": "./dist/plugins/Catmull.cjs"
    },
    "./plugins/Delaunay": {
      "types": "./dist/plugins/Delaunay.d.ts",
      "import": "./dist/plugins/Delaunay.js",
      "require": "./dist/plugins/Delaunay.cjs"
    },
    "./plugins/MatterPhysics": {
      "types": "./dist/plugins/MatterPhysics.d.ts",
      "import": "./dist/plugins/MatterPhysics.js",
      "require": "./dist/plugins/MatterPhysics.cjs"
    },
    "./plugins/Sprites": {
      "types": "./dist/plugins/Sprites.d.ts",
      "import": "./dist/plugins/Sprites.js",
      "require": "./dist/plugins/Sprites.cjs"
    },
    "./plugins/Projector": {
      "types": "./dist/plugins/Projector.d.ts",
      "import": "./dist/plugins/Projector.js",
      "require": "./dist/plugins/Projector.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shopify/Klint"
  },
  "publishConfig": {
    "access": "public",
    "@shopify:registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "creative-coding",
    "klint",
    "javascript",
    "2d",
    "canvas",
    "generative-art",
    "processing",
    "html5"
  ],
  "homepage": "https://github.com/Shopify/Klint",
  "browserslist": [
    "> 1%, not dead, not ie 11, not op_mini all"
  ],
  "bugs": {
    "url": "https://github.com/Shopify/Klint/issues"
  },
  "scripts": {
    "build": "tsup",
    "build:minified": "tsup --minify",
    "dev": "tsup --watch",
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rimraf dist",
    "version": "yarn version"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^16.0.0",
    "@types/react-dom": "^16.0.0",
    "concurrently": "^8.2.0",
    "jsdom": "^26.0.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.0.0",
    "vite": "^6.2.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.1",
    "vitest-canvas-mock": "^0.3.3"
  }
}
