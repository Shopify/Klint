#!/usr/bin/env node

const [command] = process.argv.slice(2);

const plugins = [
  ["Bezier", "@shopify/klint/plugins/Bezier"],
  ["Polyline", "@shopify/klint/plugins/Polyline"],
  ["FontParser", "@shopify/klint/plugins/FontParser"],
  ["Delaunay", "@shopify/klint/plugins/Delaunay"],
  ["CatmullRom", "@shopify/klint/plugins/Catmull"],
  ["Sprites", "@shopify/klint/plugins/Sprites"],
  ["Projector", "@shopify/klint/plugins/Projector"],
];

if (command === "create-editor") {
  import("./create-editor").catch((error) => {
    console.error("Failed to run create-editor:", error);
    process.exitCode = 1;
  });
} else if (command === "create-sandbox") {
  import("./create-sandbox").catch((error) => {
    console.error("Failed to run create-sandbox:", error);
    process.exitCode = 1;
  });
} else if (command === "list-plugins" || command === "plugins") {
  console.log("Built-in Klint plugin exports (no extra package installation required):\n");
  for (const [name, specifier] of plugins) {
    console.log(`  ${name.padEnd(12)} import { ${name} } from "${specifier}"`);
  }
} else {
  console.log(`Klint CLI\n
Commands:
  klint create-editor   Create a Klint editor project
  klint create-sandbox  Create a Klint sandbox project
  klint list-plugins    List built-in plugin import paths

Vanilla JavaScript:
  import { createKlint } from "@shopify/klint/native";`);
}
