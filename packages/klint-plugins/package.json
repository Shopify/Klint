{
  "name": "@shopify/klint-plugins",
  "version": "0.1.2",
  "description": "Plugins for Klint creative coding library",
  "author": "arthurcloche",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shopify/Klint"
  },
  "publishConfig": {
    "access": "public",
    "@shopify:registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "creative-coding",
    "klint",
    "plugins",
    "javascript",
    "2d",
    "canvas"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --external=react --external=react-dom --external=@shopify/klint",
    "build:minified": "tsup src/index.tsx --format esm,cjs --dts --minify --external=react --external=react-dom --external=@shopify/klint",
    "dev": "tsup src/index.tsx --format esm,cjs --dts --watch --external=react --external=react-dom --external=@shopify/klint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@shopify/klint": "^0.1.2",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^16.0.0",
    "@types/react-dom": "^16.0.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0"
  }
}