{
  "name": "@shopify/klint-web-component",
  "version": "0.1.2",
  "description": "Klint Web Component - Standalone creative coding in the browser",
  "main": "index.js",
  "type": "module",
  "files": [
    "index.js",
    "klint-canvas.js",
    "examples/",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "dev": "vite serve examples --port 3001",
    "build": "echo 'Web component build complete'"
  },
  "keywords": [
    "creative-coding",
    "web-components",
    "canvas",
    "klint",
    "generative-art"
  ],
  "author": "arthurcloche",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shopify/Klint"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jsdom": "^26.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vitest-canvas-mock": "^0.3.3"
  },
  "publishConfig": {
    "access": "public",
    "@shopify:registry": "https://registry.npmjs.org/"
  }
}
