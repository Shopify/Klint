{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "declaration": true,
      "jsx": "react",
      "outDir": "dist",
      "rootDir": "src",
      "lib": ["DOM", "DOM.Iterable", "ESNext"],
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "paths": {
         "~/*": ["./src/*"]
         }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"],
  }